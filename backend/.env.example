# MedTech Review Hub — backend environment configuration
# Copy to .env (or export in your shell / container) and adjust values.
# Every variable is optional; defaults shown in comments are the built-in fallbacks.

# ---- Server ----
# Port the Netty server binds to (default 8080)
PORT=8080
# Bind address (default 0.0.0.0)
HOST=0.0.0.0

# ---- Database (PostgreSQL in production) ----
# JDBC URL (default jdbc:postgresql://localhost:5432/medtech)
# Tests use an in-memory H2 URL automatically; for local dev without Postgres you can use
# DATABASE_URL=jdbc:h2:mem:medtech;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1
DATABASE_URL=jdbc:postgresql://localhost:5432/medtech
# Database user (default medtech)
DATABASE_USER=medtech
# Database password (default empty)
DATABASE_PASSWORD=change-me

# ---- Auth (JWT) ----
# HMAC secret for access tokens. MUST be changed outside local dev (default dev-only-change-me)
JWT_SECRET=dev-only-change-me
# Token issuer (default medtech-review-hub)
JWT_ISSUER=medtech-review-hub
# Access tokens live 1 h; refresh tokens 30 d and rotate on every use (not configurable).

# ---- AI providers (all keys stay server-side) ----
# none | local | openai | anthropic | gemini  (default none -> /ai/* returns 503 AI_UNAVAILABLE)
AI_PROVIDER=none
# Per-user daily token budget (default 20000)
AI_DAILY_TOKEN_BUDGET=20000
# Only read for the matching provider:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- Review content ----
# Directory with shared/content JSON (manifest.json, subjects/, lessons/, ...).
# Leave empty to use ../shared/content when present, else the bundled fallback sample.
CONTENT_DIR=

# ---- CORS ----
# Allow any origin (default true). Set to false and use ALLOWED_ORIGINS in production.
ALLOW_ALL_ORIGINS=true
# Comma-separated origins/hosts, e.g. https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# ---- Media storage ----
# Root directory for uploaded PDF files (default media). Swap for object storage in production.
MEDIA_ROOT=media
# Max upload size in bytes (default 52428800 = 50 MB)
UPLOAD_MAX_BYTES=52428800

# ---- Rate limiting (in-memory token bucket, per user/IP) ----
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AI=20

# ---- Admin ----
# Comma-separated emails that receive the ADMIN role automatically at registration
ADMIN_EMAILS=
